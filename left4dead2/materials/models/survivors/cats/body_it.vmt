"VertexLitGeneric"
{
	"$basetexture" 						"models/survivors/cats/body"
	"$bumpmap" 						"models/survivors/cats/bile_normal"
	"$phongexponenttexture"		"dev/reflectivity_90b"
 
	$phong 								"1"
	$phongexponent 					"66"
	$phongboost 						"1"
	$phongfresnelranges 			"[2 4 1]"
	$phongalbedotint 					"1"
	
	$halflambert							"1"
	$nodecal								"1"
	$nocull									"1"
	
	$emissiveBlendEnabled 			"1"
	
	$emissiveBlendFlowTexture		"vgui/white" //Flow from Green to Red. Yellow = still
	$emissiveBlendTexture				"vgui/white" //The texture that the flowmap scrolls. Not mapped to a UV
	$emissiveBlendBaseTexture		"models/survivors/cats/body_m" //The texture used for the self-illumination. Can be colored or grayscale. Does not adopt the base texture's color
	
	$emissiveBlendTint 					"[1 1 1]"
	$emissiveBlendStrength 			"1"
	$emissiveBlendScrollVector 	"[0.15 -0.17]" 

	$detail "models\survivors\survivor_it"
	$detailscale 1.75
	$detailblendfactor ".001" 
	$detailblendmode 0

	$ITAmount 0

	Proxies
	{
		IT
		{
		resultVar $ITAmount
		}
		Equals
		{
		srcVar1 $ITAmount
		resultVar $detailblendfactor
		}
	}
}
