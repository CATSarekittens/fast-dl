"VertexLitGeneric"
{
	"$basetexture" 						"models/survivors/cats/clothes"
	"$bumpmap" 						"models/survivors/cats/bile_normal"
	"$phongexponenttexture"		"dev/reflectivity_90b"
 
	$phong 								"1"
	$phongexponent 					"66"
	$phongboost 						"1"
	$phongfresnelranges 			"[2 4 1]"
	$phongalbedotint 					"1"
	
	$halflambert							"1"
	$nodecal								"1"

	$detail "models\survivors\survivor_it"
	$detailscale 1.75
	$detailblendfactor ".001" 
	$detailblendmode 0

	$ITAmount 0

	Proxies
	{
		IT
		{
		resultVar $ITAmount
		}
		Equals
		{
		srcVar1 $ITAmount
		resultVar $detailblendfactor
		}
	}
}
